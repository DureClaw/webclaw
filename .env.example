# webclaw CLI / MCP / brain — copy to .env (gitignored) and fill in.
# Loaded automatically by bin/webclaw.cjs; real environment variables take precedence.

# TypeSafe Jev (System One brain) — https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# Optional: pin a Jev model (default jev-latest; jev-preview = newest)
# WEBCLAW_JEV_MODEL=jev-latest

# Optional: default brain provider for `webclaw goal` / `webclaw brain` (jev | laya)
# WEBCLAW_BRAIN=jev

# ── Online-Mind2Web benchmark (bench/online-mind2web) ──
# Hugging Face read token — the dataset osunlp/Online-Mind2Web is gated: request access first
HF_TOKEN=
# OpenAI key for the official WebJudge judge (o4-mini)
OPENAI_API_KEY=
